# Copy to .env for local development (never commit .env)

# At least 32 random characters: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=change-me-to-a-long-random-string-of-64-characters-0000000000

# Frontend URLs allowed to call the API (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# Database
# Local MySQL (docker compose / XAMPP): host 127.0.0.1, port 3306, DB_SSL=false
# TiDB Cloud: host gateway01.<region>.prod.aws.tidbcloud.com, port 4000,
#             user like xxxxxx.root, DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moneymentor
DB_USER=moneymentor
DB_PASS=moneymentor
DB_ROOT_PASS=rootpass
# true for TiDB Cloud
DB_SSL=false

# Certificate bundle for HTTPS/TLS (Cloudinary, TiDB). Not needed on Linux/Docker/Render.
# On Windows/XAMPP: download https://curl.se/ca/cacert.pem and point to it, e.g.
# CA_BUNDLE=C:\xampp\php\extras\ssl\cacert.pem
CA_BUNDLE=

# Cloudinary for article images (Dashboard → API Keys → "API environment variable").
# Leave empty locally to store images in the database instead.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=moneymentor/articles

# First admin account, created on start-up if it doesn't exist (password: 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin
